{
  "manifest_version": 3,
  "name": "OpenTransAI · AI 翻译",
  "version": "1.0.0",
  "description": "划词、图片和框选截图翻译，在统一浮窗中阅读。使用你自己的 AI 服务、视觉模型与 Key。",
  "minimum_chrome_version": "123",
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ],
  "optional_host_permissions": [
    "<all_urls>",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "OpenTransAI · AI 翻译",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/light/icon-16.png",
      "32": "icons/light/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/light/icon-16.png",
    "32": "icons/light/icon-32.png",
    "48": "icons/light/icon-48.png",
    "128": "icons/light/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "lib/errors-shared.js",
        "lib/page-shared.js",
        "lib/image-format.js",
        "lib/panel.js",
        "lib/image-entry.js",
        "lib/capture.js",
        "content.js",
        "lib/x-translation.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/ai-translate-light.svg"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
